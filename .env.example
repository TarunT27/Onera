# Copy to .env.local and fill in. Never commit real keys.

# Claude API key for the "Ask Onera" assistant (server-side only).
# Without it, chat falls back to a clearly labeled deterministic summary.
ANTHROPIC_API_KEY=

# Model used by the assistant.
CLEARFI_MODEL=claude-opus-5-5

# Optional Anthropic server-side refusal fallback beta. Requires account access.
# Leave disabled for ordinary model requests; local deterministic fallback still works.
CLEARFI_SERVER_FALLBACK=false

# live | fallback — force fallback mode for offline demos.
CLEARFI_AI_MODE=live

# ElevenLabs key for voice (speech-to-text + spoken replies), server-side only.
# Without it the "Talk to Onera" button shows how to turn voice on.
ELEVENLABS_API_KEY=

# Optional voice overrides. Defaults: George voice, Flash TTS, Scribe v2 STT.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# SQLite file location (created and seeded automatically).
CLEARFI_DB_PATH=./data/clearfi.db
